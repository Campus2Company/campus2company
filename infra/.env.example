# ── Shared Database Credentials ───────────────────────────────────────────────
# Used across all service databases (same username/password, different DBs)
DB_USERNAME=
DB_PASSWORD=

# ── Local Development Only ────────────────────────────────────────────────────
# When running a service directly in IntelliJ (not Docker), set the DB_URL here
# Docker overrides this per-service automatically
DB_URL=jdbc:postgresql://localhost:5432/auth_db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
